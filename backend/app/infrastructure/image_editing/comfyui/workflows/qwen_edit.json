{
  "load_image": {
    "class_type": "LoadImage",
    "inputs": { "image": "__IMAGE_FILENAME__" }
  },
  "scale": {
    "class_type": "FluxKontextImageScale",
    "inputs": { "image": ["load_image", 0] }
  },
  "unet_loader": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "__UNET_NAME__", "weight_dtype": "default" }
  },
  "clip_loader": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "__CLIP_NAME__", "type": "qwen_image", "device": "default" }
  },
  "vae_loader": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "__VAE_NAME__" }
  },
  "model_sampling": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": { "model": ["unet_loader", 0], "shift": "__MODEL_SHIFT__" }
  },
  "cfg_norm": {
    "class_type": "CFGNorm",
    "inputs": { "model": ["model_sampling", 0], "strength": "__CFG_NORM_STRENGTH__" }
  },
  "lora": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["cfg_norm", 0],
      "lora_name": "__LORA_NAME__",
      "strength_model": "__LORA_STRENGTH__"
    }
  },
  "positive_cond": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "inputs": {
      "clip": ["clip_loader", 0],
      "vae": ["vae_loader", 0],
      "image1": ["scale", 0],
      "prompt": "__PROMPT_TEXT__"
    }
  },
  "positive_ref": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "inputs": {
      "conditioning": ["positive_cond", 0],
      "reference_latents_method": "index_timestep_zero"
    }
  },
  "negative_cond": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "inputs": {
      "clip": ["clip_loader", 0],
      "vae": ["vae_loader", 0],
      "image1": ["scale", 0],
      "prompt": ""
    }
  },
  "negative_ref": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "inputs": {
      "conditioning": ["negative_cond", 0],
      "reference_latents_method": "index_timestep_zero"
    }
  },
  "vae_encode": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["scale", 0], "vae": ["vae_loader", 0] }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["lora", 0],
      "positive": ["positive_ref", 0],
      "negative": ["negative_ref", 0],
      "latent_image": ["vae_encode", 0],
      "seed": "__SEED__",
      "steps": "__STEPS__",
      "cfg": "__CFG__",
      "sampler_name": "__SAMPLER_NAME__",
      "scheduler": "__SCHEDULER__",
      "denoise": 1.0
    }
  },
  "vae_decode": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["sampler", 0], "vae": ["vae_loader", 0] }
  },
  "save_image": {
    "class_type": "SaveImage",
    "inputs": { "images": ["vae_decode", 0], "filename_prefix": "smart_editor" }
  }
}
