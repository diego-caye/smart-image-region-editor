# Copy to .env for native (non-Docker) runs. Docker Compose does NOT read
# this file — it uses the root-level .env instead (see ../.env.example),
# which overrides several of these for the container environment (paths,
# COMFYUI_BASE_URL). Values below are the native-dev defaults.

# --- Storage ---
STORAGE_ROOT=./data/images
STATIC_URL_PREFIX=/static

# --- Database (SQLite for the MVP) ---
DATABASE_URL=sqlite:///./data/app.db

# --- CORS: origins allowed to call this API (the frontend dev server) ---
CORS_ALLOW_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180"]

# --- ComfyUI (native: reachable directly on localhost) ---
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_POLL_INTERVAL_SECONDS=1.0
COMFYUI_TIMEOUT_SECONDS=180.0

# --- Detection/segmentation device placement ---
# YOLOv8n face/hand: tiny, fast, no VRAM impact -> cpu by default.
# SAM2: quality benefits from GPU; released after each call so ComfyUI's
# Qwen edit step (much larger) has VRAM to work with -> cuda by default.
DETECTION_DEVICE=cpu
SEGMENTATION_DEVICE=cuda

# Reuses your local ComfyUI's already-downloaded YOLO weights instead of
# duplicating the download. Point elsewhere if you'd rather keep a private
# copy.
YOLO_FACE_MODEL_PATH=C:/ComfyUI/models/ultralytics/bbox/face_yolov8n.pt
YOLO_HAND_MODEL_PATH=C:/ComfyUI/models/ultralytics/bbox/hand_yolov8n.pt

# SAM2's official pip package needs its own checkpoint format (not the
# safetensors ComfyUI's custom node uses) — downloaded/cached here on
# first use.
SAM2_MODEL_ID=facebook/sam2-hiera-base-plus
MODELS_CACHE_DIR=./models_cache
