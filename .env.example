# Copy to .env (repo root) before `docker compose up`. These ports are
# deliberately NOT the common 8000/5173 defaults, to avoid clashing with
# other local projects — change them freely.
BACKEND_PORT=8420
FRONTEND_PORT=5180

# Host port ComfyUI's own web UI is reachable at (http://localhost:8188) —
# useful for inspecting the workflow graph/queue directly. ComfyUI now runs
# in its own container (see docker-compose.yml's `comfyui` service) built
# from a vanilla clone; it downloads its own models into a Docker volume on
# first start, so no separate ComfyUI install is required to run this repo.
COMFYUI_PORT=8188

# Leave COMFYUI_BASE_URL unset to use the containerized ComfyUI above
# (default: http://comfyui:8188). Only set this if you'd rather point the
# backend at a native ComfyUI install instead — e.g.
# http://host.docker.internal:8188 on Docker Desktop.
# COMFYUI_BASE_URL=http://host.docker.internal:8188

# Optional: host path to a native ComfyUI install's models dir, mounted
# read-only into the backend container purely so its YOLO weights are
# reused instead of re-downloaded from Hugging Face. Leave unset if you
# don't have one — the backend downloads them itself either way.
# COMFYUI_MODELS_DIR=C:/ComfyUI/models

# Detection/segmentation device placement inside the backend container (see
# docs/architecture.md for the VRAM-sharing rationale). Requires the
# `nvidia` container runtime for DEVICE=cuda to work (check with
# `docker run --gpus all ... nvidia-smi`).
DETECTION_DEVICE=cpu
SEGMENTATION_DEVICE=cuda

SAM2_MODEL_ID=facebook/sam2-hiera-base-plus
