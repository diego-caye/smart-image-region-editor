# Copy to .env (repo root) before `docker compose up`. These ports are
# deliberately NOT 8000/5173/5432 — those are already in use by another
# project on this machine.
BACKEND_PORT=8420
FRONTEND_PORT=5180

# From inside a container, 127.0.0.1 refers to the container itself, not
# the host — Docker Desktop's host.docker.internal is what reaches your
# host machine's ComfyUI. Native (non-Docker) runs use backend/.env instead,
# where COMFYUI_BASE_URL correctly stays http://127.0.0.1:8188.
COMFYUI_BASE_URL=http://host.docker.internal:8188

# Host path to your ComfyUI install's models dir, mounted read-only into the
# backend container so YOLO weights are reused instead of re-downloaded.
COMFYUI_MODELS_DIR=C:/ComfyUI/models

# Detection/segmentation device placement inside the backend container (see
# docs/architecture.md for the VRAM-sharing rationale). Requires the
# `nvidia` container runtime for DEVICE=cuda to work — already confirmed
# available on this machine (`docker info` / `docker run --gpus all`).
DETECTION_DEVICE=cpu
SEGMENTATION_DEVICE=cuda

SAM2_MODEL_ID=facebook/sam2-hiera-base-plus
